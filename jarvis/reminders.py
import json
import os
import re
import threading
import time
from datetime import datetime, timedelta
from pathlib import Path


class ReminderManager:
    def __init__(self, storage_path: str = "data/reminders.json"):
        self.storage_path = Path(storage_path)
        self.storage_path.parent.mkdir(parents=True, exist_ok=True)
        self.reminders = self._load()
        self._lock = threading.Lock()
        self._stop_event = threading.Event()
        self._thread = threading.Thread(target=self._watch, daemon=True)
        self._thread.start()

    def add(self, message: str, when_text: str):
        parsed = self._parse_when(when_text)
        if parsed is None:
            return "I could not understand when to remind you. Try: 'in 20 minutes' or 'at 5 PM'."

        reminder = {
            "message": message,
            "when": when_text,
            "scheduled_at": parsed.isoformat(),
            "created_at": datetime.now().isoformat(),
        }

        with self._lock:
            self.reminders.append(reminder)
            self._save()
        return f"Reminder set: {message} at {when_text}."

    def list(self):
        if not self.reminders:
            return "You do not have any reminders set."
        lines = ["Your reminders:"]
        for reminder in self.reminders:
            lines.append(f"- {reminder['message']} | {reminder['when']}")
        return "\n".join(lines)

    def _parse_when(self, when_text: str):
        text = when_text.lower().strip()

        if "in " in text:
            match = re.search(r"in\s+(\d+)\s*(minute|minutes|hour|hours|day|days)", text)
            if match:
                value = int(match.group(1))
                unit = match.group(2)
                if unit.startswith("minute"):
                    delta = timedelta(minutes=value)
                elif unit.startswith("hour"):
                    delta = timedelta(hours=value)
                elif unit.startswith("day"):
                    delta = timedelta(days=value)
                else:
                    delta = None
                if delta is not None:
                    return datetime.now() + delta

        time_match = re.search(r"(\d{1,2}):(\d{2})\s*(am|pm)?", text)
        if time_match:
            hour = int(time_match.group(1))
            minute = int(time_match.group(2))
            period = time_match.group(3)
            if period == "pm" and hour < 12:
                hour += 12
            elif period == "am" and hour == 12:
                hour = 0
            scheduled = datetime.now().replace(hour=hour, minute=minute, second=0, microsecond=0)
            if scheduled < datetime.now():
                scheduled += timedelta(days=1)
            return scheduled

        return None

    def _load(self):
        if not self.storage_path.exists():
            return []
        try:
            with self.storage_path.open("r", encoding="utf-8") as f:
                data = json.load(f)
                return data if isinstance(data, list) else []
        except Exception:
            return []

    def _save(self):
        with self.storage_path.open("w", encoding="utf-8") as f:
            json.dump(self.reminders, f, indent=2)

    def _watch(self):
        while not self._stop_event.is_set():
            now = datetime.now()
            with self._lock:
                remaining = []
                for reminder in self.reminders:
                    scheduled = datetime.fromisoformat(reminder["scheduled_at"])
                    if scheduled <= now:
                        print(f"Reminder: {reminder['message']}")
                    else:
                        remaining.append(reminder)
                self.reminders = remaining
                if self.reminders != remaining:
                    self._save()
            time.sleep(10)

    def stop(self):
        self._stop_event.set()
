import os
import re
import subprocess
import sys
import webbrowser
from datetime import datetime
from pathlib import Path


class CommandHandler:
    def __init__(self):
        self.app_map = {
            "vscode": "code",
            "visual studio code": "code",
            "code": "code",
            "chrome": "google-chrome",
            "browser": "google-chrome",
            "firefox": "firefox",
            "terminal": "terminal",
            "cmd": "cmd",
            "notepad": "notepad",
            "calculator": "calc",
            "music": "spotify",
            "spotify": "spotify",
            "file explorer": "explorer",
            "explorer": "explorer",
        }

    def handle(self, text: str):
        if not text:
            return None

        lower = text.lower().strip()

        if lower in {"exit", "quit", "bye", "goodbye", "shutdown"}:
            return "__EXIT__"

        if lower.startswith("open ") or lower.startswith("launch "):
            return self.open_app_or_url(text)

        if "remind" in lower or "reminder" in lower or "alarm" in lower:
            return {"type": "reminder", "text": text}

        if "play" in lower:
            return {"type": "play", "text": text}

        if "time" in lower:
            return {"type": "time", "text": text}

        if "date" in lower:
            return {"type": "date", "text": text}

        if lower.startswith("search "):
            return {"type": "search", "text": text}

        if "folder" in lower or "directory" in lower:
            return {"type": "folder", "text": text}

        return None

    def open_app_or_url(self, text: str):
        command = text.strip()
        lower = command.lower()

        if re.search(r"https?://|www\.", command):
            webbrowser.open(command)
            return "Opened the link you asked for."

        app_name = command.split(maxsplit=1)[1].strip() if " " in command else ""
        clean_name = app_name.lower().strip("\"'")

        if not clean_name:
            return "Which app or website should I open?"

        app = self.app_map.get(clean_name, clean_name)

        try:
            if sys.platform.startswith("win"):
                if app in {"explorer", "cmd", "notepad", "calc"}:
                    subprocess.Popen(app, shell=True)
                else:
                    subprocess.Popen(app)
            else:
                subprocess.Popen(app)
            return f"Opened {clean_name}."
        except Exception:
            try:
                webbrowser.open(f"https://www.google.com/search?q={clean_name}")
                return f"Opened a browser search for {clean_name}."
            except Exception:
                return f"I could not open {clean_name}."

    def open_path(self, path: str):
        try:
            Path(path).mkdir(parents=True, exist_ok=True)
            if sys.platform.startswith("win"):
                os.startfile(path)
            else:
                subprocess.Popen(["xdg-open", path])
            return f"Opened {path}."
        except Exception:
            return f"I could not open {path}."

    def play_media(self, text: str):
        query = text.replace("play", "", 1).strip()
        if not query:
            return "What should I play?"
        search_url = f"https://www.youtube.com/results?search_query={query.replace(' ', '+')}"
        webbrowser.open(search_url)
        return f"Searching for {query} on YouTube."

    def current_time(self):
        return datetime.now().strftime("%I:%M %p")

    def current_date(self):
        return datetime.now().strftime("%A, %B %d, %Y")

    def search_web(self, text: str):
        query = text.replace("search", "", 1).strip()
        if not query:
            return "What should I search for?"
        webbrowser.open(f"https://www.google.com/search?q={query.replace(' ', '+')}")
        return f"Searching the web for {query}."
